# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Everything except GEMINI_API_KEY is optional and fail-soft (see README.md
# § Environment Configuration for which feature each one gates).

# ── Google Gemini API (required) ────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Alternative env var name some Google SDKs look for; either works.
# GOOGLE_API_KEY=""

# ── Tavily Web Search API (optional — enables the web_search tool) ─────────
TAVILY_API_KEY=""

# ── Local / OpenAI-compatible endpoint (optional — falls back to Gemini) ───
# Used for the summarizer (ingest) and, optionally, the generator/grader.
LLM_BASE_URL="http://your-vllm-or-nim-server:8080/v1"
LLM_API_KEY=""

# ── Remote embedding server (optional — falls back to local BAAI/bge-m3) ───
EMBEDDING_BASE_URL=""

# ── LangSmith tracing (optional — enables trace links in trajectory.txt) ───
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="slidegen-rag"
# Resolves an extra "view trace" URL per run; costs one read API call.
LANGSMITH_RESOLVE_RUN_URL="true"

# ── Trajectory logging (optional — independent of LangSmith, always local) ─
TRAJECTORY_ENABLED="true"

# ── Postgres / session memory (required for Streamlit UI and REST API) ─────
# postgresql+asyncpg://user:password@host:port/dbname
# Unset: CLI falls back to in-memory sessions (lost on exit); the Streamlit
# UI and the REST API both refuse to start without a reachable Postgres.
DATABASE_URL=""
# Set to "false" to force in-memory sessions for the CLI even with
# DATABASE_URL set (ignored by the Streamlit UI / REST API, which always
# require Postgres).
MEMORY_PERSIST="true"

# ── REST API CORS (optional — only read by `slidegen-api`) ─────────────────
# Comma-separated list of frontend origins allowed to call the API.
API_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
